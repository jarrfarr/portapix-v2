# Generated by EventHub. Do not edit by hand.
[Unit]
Description=EventHub event storage ({{ label }})
Documentation=file:///etc/eventhub/config.yaml
ConditionPathExists={{ what }}
{% if uuid %}
After=dev-disk-by\x2duuid-{{ uuid | replace('-', '\\x2d') }}.device
{% endif %}

[Mount]
What={{ what }}
Where={{ where }}
Type={{ fstype }}
Options={{ options }}
TimeoutSec={{ timeout }}

[Install]
WantedBy=multi-user.target
