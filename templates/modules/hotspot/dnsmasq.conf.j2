# Generated by EventHub. Do not edit by hand.
interface={{ interface }}
bind-dynamic
except-interface=lo
dhcp-authoritative
dhcp-range={{ dhcp_start }},{{ dhcp_end }},{{ netmask }},{{ lease_time }}
dhcp-option=option:router,{{ server_ip }}
dhcp-option=option:dns-server,{{ server_ip }}
dhcp-option=option:domain-name,{{ domain }}
domain={{ domain }}
local=/{{ domain }}/
address=/{{ domain }}/{{ server_ip }}
expand-hosts
domain-needed
bogus-priv
no-resolv
{% for server in dns_servers %}
server={{ server }}
{% endfor %}
dhcp-leasefile=/var/lib/misc/dnsmasq.leases
log-dhcp
