# Generated by EventHub. Do not edit by hand.
# copyparty config (INI-style); account passwords are argon2 hashes.
[global]
  p: {{ port }}
  i: {{ bind }}
  name: EventHub
  e2dsa
  e2ts
  no-robots
  hist: {{ hist_dir }}
  th-maxage: {{ thumbnail_age }}
  ah-alg: argon2,3,256,4,19
  ah-salt: {{ salt }}
{% if minimum_free_gb %}
  df: {{ minimum_free_gb }}
{% endif %}
{% if base_url and base_url != '/' %}
  rp-loc: {{ base_url }}
{% endif %}
{% if thumbnails == 'off' %}
  no-thumb
{% elif thumbnails == 'pyvips' %}
  th-dec: vips,pil,ff
{% elif thumbnails == 'pil' %}
  th-dec: pil,ff
{% endif %}
{% for arg in extra_args %}
  {{ arg }}
{% endfor %}

[accounts]
{% for user in users %}
  {{ user.username }}: {{ user.password_hash }}
{% endfor %}

[groups]
{% for group in groups %}
  {{ group.name }}: {{ group.members | join(', ') }}
{% endfor %}

[/]
  {{ landing_dir }}
  accs:
    r: @acct
{% for permission, names in root_accs.items() %}
    {{ permission }}: {{ names | join(', ') }}
{% endfor %}
{% if active_volume %}

[/active]
  {{ active_volume.path }}
  accs:
{% for permission, names in active_volume.accs.items() %}
    {{ permission }}: {{ names | join(', ') }}
{% endfor %}
{% endif %}

[/inbox]
  {{ inbox_dir }}
  accs:
{% for permission, names in inbox_accs.items() %}
    {{ permission }}: {{ names | join(', ') }}
{% endfor %}
{% if duplicate_detection %}
  flags:
    nodupe
{% endif %}
{% for volume in volumes %}

[/events/{{ volume.slug }}]
  {{ volume.path }}
  accs:
{% for permission, names in volume.accs.items() %}
    {{ permission }}: {{ names | join(', ') }}
{% endfor %}
{% if volume.archived and archive_read_only %}
  flags:
    dthumb
{% endif %}
{% endfor %}
{% for name, extra in extra_volumes.items() %}

[{{ name }}]
  {{ extra.path }}
{% if extra.accs %}
  accs:
{% for permission, names in extra.accs.items() %}
    {{ permission }}: {{ names }}
{% endfor %}
{% endif %}
{% if extra.flags %}
  flags:
    {{ extra.flags }}
{% endif %}
{% endfor %}
