# Generated by EventHub. Do not edit by hand.
[global]
  workgroup = {{ workgroup }}
  server string = {{ server_string }}
  server role = standalone server
  security = user
  map to guest = never
  usershare allow guests = no
  smb ports = 445
  server min protocol = {{ min_protocol }}
  server max protocol = {{ max_protocol }}
  client min protocol = SMB2
  socket options = {{ socket_options }}
  aio read size = {{ aio_read_size }}
  aio write size = {{ aio_write_size }}
  use sendfile = {{ 'yes' if use_sendfile else 'no' }}
  strict sync = {{ 'yes' if strict_sync else 'no' }}
  veto files = {{ veto_files }}
  delete veto files = yes
  hide dot files = {{ 'yes' if hide_dot_files else 'no' }}
  load printers = no
  printing = bsd
  printcap name = /dev/null
  disable spoolss = yes
  log file = /var/log/eventhub/samba/%m.log
  max log size = 128
  passdb backend = tdbsam
  unix password sync = no
  pam password change = no
  obey pam restrictions = yes
  server signing = auto
  ea support = yes
  store dos attributes = yes
  wide links = no
  follow symlinks = no

{% for share in shares %}
[{{ share.name }}]
  path = {{ share.path }}
  browseable = {{ 'yes' if share.browseable else 'no' }}
  guest ok = no
  read only = yes
  valid users = {{ share.valid_users | join(', ') }}
{% if share.write_users %}
  write list = {{ share.write_users | join(', ') }}
{% endif %}
  create mask = 0660
  directory mask = 0770
  force group = {{ share.group }}
  inherit permissions = yes
  ea support = yes
  store dos attributes = yes

{% endfor %}
