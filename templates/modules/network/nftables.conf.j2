# Generated by EventHub. Do not edit by hand.
# Only the hotspot subnet and the wired LAN may reach appliance services.
# Forwarded traffic is limited to the uplink; AP/LAN clients can never reach
# the uplink's own LAN (masquerading + forward policy).
table inet {{ table }} {
    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
        meta nfproto ipv6 icmpv6 type { echo-request, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, packet-too-big, destination-unreachable, time-exceeded } accept

{% if ap %}
        # DHCP and DNS on the hotspot
        iifname "{{ ap }}" ip saddr {{ subnet }} udp dport 67 accept
        iifname "{{ ap }}" ip saddr {{ subnet }} udp dport 53 accept
        iifname "{{ ap }}" ip saddr {{ subnet }} tcp dport 53 accept

        # Appliance services for hotspot clients
        iifname "{{ ap }}" ip saddr {{ subnet }} tcp dport { 22, 139, 445, 5353 } accept
        iifname "{{ ap }}" ip saddr {{ subnet }} udp dport { 137, 138, 5353 } accept
{% if dashboard_enabled %}
        iifname "{{ ap }}" ip saddr {{ subnet }} tcp dport {{ dashboard_port }} accept
{% endif %}
{% if copyparty_enabled %}
        iifname "{{ ap }}" ip saddr {{ subnet }} tcp dport {{ copyparty_port }} accept
{% endif %}
{% endif %}

{% if lan %}
        # Wired editor LAN: full access to appliance services
        iifname "{{ lan }}" tcp dport { 22, 53, 139, 445, 5353 } accept
        iifname "{{ lan }}" udp dport { 53, 137, 138, 5353 } accept
{% if dashboard_enabled %}
        iifname "{{ lan }}" tcp dport {{ dashboard_port }} accept
{% endif %}
{% if copyparty_enabled %}
        iifname "{{ lan }}" tcp dport {{ copyparty_port }} accept
{% endif %}
{% endif %}

{% if wan %}
        # The WAN side may only answer our own outbound traffic and DHCP.
        iifname "{{ wan }}" udp sport 67 udp dport 68 accept
{% endif %}

{% if airdrop_enabled %}
        # AirDrop receiver (owly) on the AWDL interface
        iifname "{{ awdl_interface }}" tcp dport {{ airdrop_port }} accept
{% endif %}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
{% if sharing and wan %}
{% if ap %}
        iifname "{{ ap }}" oifname "{{ wan }}" accept
{% endif %}
{% if lan %}
        iifname "{{ lan }}" oifname "{{ wan }}" accept
{% endif %}
{% endif %}
    }

{% if sharing and wan %}
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "{{ wan }}" masquerade
    }
{% endif %}
}
