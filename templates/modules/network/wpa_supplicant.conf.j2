# Generated by EventHub for {{ interface }}. Do not edit by hand.
ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=1
country={{ country | default('GB') }}

network={
    ssid="{{ ssid | replace('"', '\\"') }}"
{% if password %}
    psk="{{ password | replace('"', '\\"') }}"
    key_mgmt=WPA-PSK SAE
    ieee80211w=1
{% else %}
    key_mgmt=NONE
{% endif %}
}
