# Generated by EventHub. Do not edit by hand.
[server]
use-ipv4=yes
use-ipv6=no
{% if interfaces %}
allow-interfaces={{ interfaces | join(',') }}
{% endif %}
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[publish]
publish-addresses=yes
publish-hinfo=no
publish-workstation=yes
publish-domain=no

[wide-area]
enable-wide-area=no

[rlimits]
rlimit-core=0
