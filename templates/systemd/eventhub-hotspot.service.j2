[Unit]
Description=EventHub wifi hotspot
After=network.target eventhub-network.service
Wants=eventhub-network.service
ConditionPathExists={{ config_path }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ venv }}/bin/eventhub --config {{ config_path }} module hotspot start
ExecStop={{ venv }}/bin/eventhub --config {{ config_path }} module hotspot stop
User=root
Group=root
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
Environment=PYTHONUNBUFFERED=1
Environment=EVENTHUB_CONFIG={{ config_path }}

[Install]
WantedBy=multi-user.target
