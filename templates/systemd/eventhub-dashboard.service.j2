[Unit]
Description=EventHub web dashboard
After=network.target eventhub-helper.service
Requires=eventhub-helper.service
ConditionPathExists={{ config_path }}

[Service]
Type=simple
ExecStart={{ venv }}/bin/python -m eventhub.dashboard.app
Restart=on-failure
RestartSec=3
User={{ dashboard_user }}
Group={{ install.dashboard_group }}
SupplementaryGroups={{ service_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={{ state_dir }} {{ log_dir }}
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=EVENTHUB_CONFIG={{ config_path }}
Environment=EVENTHUB_DASHBOARD_CONFIG=/etc/eventhub/dashboard.json
Environment=EVENTHUB_HELPER_SOCKET={{ helper.socket_path }}

[Install]
WantedBy=multi-user.target
